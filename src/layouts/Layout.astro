---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { profile } from '../content';
import Arrow from '../components/Arrow.astro';
import { withBase } from '../urls';
import ThemeScript from '../components/ThemeScript.astro';
interface Props { title?: string; description?: string; }
const { title = 'Volkan — Backend systems & useful open-source tools', description = profile.intro } = Astro.props;
const canonicalPath = `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site) : null;
const home = Astro.url.pathname.replace(/\/$/, '') === withBase().replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f4f1e8" />
    <ThemeScript />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(withBase('social.png'), Astro.site)} /></>}
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href={withBase()} class="wordmark" aria-label="Volkan — home"><span class="brand-mark" aria-hidden="true">v.</span><span>Volkan<span class="wordmark-dot">.</span></span></a>
      <nav aria-label="Main navigation">
        <a href={home ? '#work' : withBase('#work')}>Work</a><a href={home ? '#consulting' : withBase('#consulting')}>Consulting</a><a href={home ? '#about' : withBase('#about')}>About</a><a href={home ? '#contact' : withBase('#contact')}>Contact</a>
        <a class="nav-github" href={profile.github}>GitHub <Arrow external /></a>
      </nav>
      <div class="theme-control" hidden>
        <label for="theme-choice">Theme</label>
        <select id="theme-choice" aria-label="Color theme">
          <option value="system" selected>System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap"><a class="wordmark" href={withBase()}>Volkan<span class="wordmark-dot">.</span></a><p>Thoughtful systems. Useful software.</p><span class="mono">BERLIN, DE · © {new Date().getFullYear()}</span><a href={profile.github}>GitHub <Arrow external /></a></footer>
  </body>
</html>
