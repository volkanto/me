---
import Layout from '../../layouts/Layout.astro';
import NoteList from '../../components/NoteList.astro';
import Arrow from '../../components/Arrow.astro';
import { publishedNotes, topicLabel } from '../../notes';
import { writing } from '../../content';
import { withBase } from '../../urls';
const notes = await publishedNotes();
const topics = [...new Set(notes.flatMap(note => note.data.tags))].sort();
---
<Layout title="Engineering notes — Volkan" description={writing.intro}>
  <section class="notes-page wrap" aria-labelledby="notes-title">
    <header class="notes-heading"><div><span class="eyebrow">THE OPEN NOTEBOOK / VOLKAN</span><h1 id="notes-title">{writing.title[0]}<br /><span>{writing.title[1]}</span></h1><p>{writing.intro}</p></div><div class="notebook-label"><span class="mono">SMALL IDEAS<br />WRITTEN DOWN.</span><span class="notebook-arrow" aria-hidden="true"><Arrow external /></span><span class="mono">BACKEND / TOOLS / TRADE-OFFS</span></div></header>
    <div class="notes-toolbar"><span class="mono">{notes.length} {notes.length === 1 ? 'PUBLISHED NOTE' : 'PUBLISHED NOTES'}</span>{notes.length > 0 && <a class="text-link" href={withBase('notes/feed.xml')}>RSS feed <Arrow /></a>}</div>
    {topics.length > 0 && <nav class="note-topics topic-directory" aria-label="Browse notes by topic"><span class="mono">BROWSE BY TOPIC</span>{topics.map(topic => <a href={withBase(`notes/topics/${topic}/`)}>{topicLabel(topic)}</a>)}</nav>}
    {notes.length > 0 ? <NoteList notes={notes} /> : <div class="notes-empty"><span class="mono">A FRESH PAGE</span><div><h2>{writing.emptyTitle}</h2><p>{writing.emptyCopy}</p><a class="text-link" href={withBase('#work')}>Explore what I’m building <Arrow /></a></div></div>}
    <aside class="notes-foot"><p>More interested in working together?</p><a class="text-link" href={withBase('#consulting')}>Bring me a backend challenge <Arrow /></a></aside>
  </section>
</Layout>
