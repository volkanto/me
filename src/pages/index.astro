---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import SystemSketch from '../components/SystemSketch.astro';
import { profile, projects, services, principles } from '../content';
import { withBase } from '../urls';
const rook = projects[0];
const contactUrl = profile.contact.email ? `mailto:${profile.contact.email}` : profile.contact.github;
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-topline mono"><span><span class="status-dot" aria-hidden="true"></span>{profile.hero.context}</span><span class="hero-index">SYSTEMS & SIDE PROJECTS</span></div>
    <div class="hero-layout">
      <div class="hero-copy"><h1 id="hero-title">{profile.hero.title[0]}<br /><span>{profile.hero.title[1]}</span></h1><div class="hero-details"><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button" href="#work">Explore my work <Arrow /></a><a class="text-link" href="#contact">Discuss a project <Arrow /></a></div></div></div>
      <SystemSketch />
    </div>
    <div class="hero-bottom"><p>{profile.hero.note}</p><a class="mono" href="#work">SCROLL TO THE WORK <span aria-hidden="true">↓</span></a></div>
  </section>
  <div class="expertise-strip"><div class="wrap"><span class="mono">MY WORKING TERRITORY</span><ul><li>Java & Spring Boot</li><li>Backend architecture</li><li>Reliability & performance</li><li>Open source</li></ul></div></div>
  <section id="work" class="work-section wrap" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">01 / PROJECT FILES</span><h2 id="work-title">Useful by design.<br /><span class="muted-heading">Open by default.</span></h2></div><p>Small tools, real problems.<br />Built to use. Shared to improve.</p></div>
    <article class="featured-project">
      <div class="featured-copy"><div class="project-meta mono"><span class="project-number">01</span><span>{rook.kind}</span></div><h3>{rook.name}</h3><p class="project-headline">{rook.headline}</p><p>{rook.description}</p><ul class="feature-list"><li>Private, local-first storage</li><li>Weekly & monthly summaries</li><li>Markdown export & backups</li></ul><div class="tags">{rook.stack.map(tag => <span>{tag}</span>)}</div><div class="project-links"><a class="text-link" href={withBase(`projects/${rook.slug}/`)}>Explore the project <Arrow /></a><a href={rook.source}>Source <Arrow external /></a>{rook.live && <a href={rook.live}>Open app <Arrow external /></a>}</div></div>
      <div class="product-stage"><div class="product-stage-heading"><span class="mono">PRIVATE BY DESIGN.</span><span class="mono">YOURS TO KEEP.</span></div><ProjectVisual slug={rook.slug} /></div>
    </article>
    <div class="secondary-projects">{projects.slice(1).map(project => <article class:list={['compact-project', `project-${project.slug}`]}><div class="compact-copy"><div class="project-meta mono"><span class="project-number">{project.number}</span><span>{project.kind}</span></div><h3>{project.name}<span class="project-title-dot" aria-hidden="true">.</span></h3><p class="project-headline">{project.headline}</p><p>{project.description}</p><p class="project-audience">{project.audience}</p><div class="project-links"><a class="text-link" href={withBase(`projects/${project.slug}/`)}>Explore the project <Arrow /></a><a href={project.source}>Source <Arrow external /></a></div></div><ProjectVisual slug={project.slug} /></article>)}</div>
    <div class="work-end"><span class="mono">SMALL SURFACES. THOUGHTFUL FOUNDATIONS.</span><a class="text-link" href={profile.github}>More on GitHub <Arrow external /></a></div>
  </section>
  <section class="approach-section" aria-labelledby="approach-title"><div class="wrap approach-layout"><div class="approach-copy"><span class="eyebrow">02 / ENGINEERING NOTES</span><h2 id="approach-title">The details<br />do the<br /><span>heavy lifting.</span></h2><p>I care about what happens beneath the interface: how services fit together, how they fail, and how they evolve.</p><span class="approach-footnote mono">GOOD SYSTEMS START WITH GOOD QUESTIONS.</span></div><div class="principles">{principles.map((item, i) => <div class="principle"><span class="mono">0{i + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div><span class="principle-mark" aria-hidden="true">+</span></div>)}</div></div></section>
  <section id="consulting" class="consulting-section wrap" aria-labelledby="consulting-title"><div class="section-heading"><div><span class="eyebrow">03 / WORKING TOGETHER</span><h2 id="consulting-title">Have a backend<br />challenge?</h2></div><p>I help teams design, review, and improve Java and Spring Boot systems—from architecture decisions to production reliability.</p></div><div class="services">{services.map((service, i) => <article><div class="service-title"><span class="mono">0{i + 1}</span><h3>{service.title}</h3></div><p>{service.problem}</p><div class="service-outcome"><span class="mono">A USEFUL ENGAGEMENT</span><p>{service.result}</p></div></article>)}</div><div class="process"><span class="eyebrow">A STRAIGHTFORWARD START</span><ol><li><span>01</span><p>Share the challenge<br />and relevant context.</p></li><li><span>02</span><p>Agree on scope,<br />deliverables, and timing.</p></li><li><span>03</span><p>Work through the problem.<br />Leave with actionable next steps.</p></li></ol><a class="button button-outline" href="#contact">Let’s discuss your project <Arrow /></a></div></section>
  <section id="about" class="about-section wrap" aria-labelledby="about-title"><div class="about-label"><span class="eyebrow">04 / THE PERSON BEHIND THE WORK</span><div class="location-stamp"><span class="location-name">Berlin<span aria-hidden="true">.</span></span><span class="mono">52°31′ N &nbsp; 13°24′ E</span><span class="mono">A PLACE TO CALL HOME.</span></div></div><div class="about-copy"><h2 id="about-title">Curiosity is<br />a good starting point.</h2><p>{profile.about}</p><p>I care about reliability, simplicity, and software that earns its place in someone’s day.</p><a class="text-link" href={profile.github}>Find me on GitHub <Arrow external /></a></div></section>
  <aside class="support-section wrap"><div><span class="support-mark" aria-hidden="true"><Arrow external /></span><div><h2>Useful to you? Help it grow.</h2><p>If my projects make your day a little easier, you can support their continued development.</p></div></div><a class="text-link" href={profile.sponsors}>GitHub Sponsors <Arrow external /></a></aside>
  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="wrap"><span class="eyebrow">05 / START A CONVERSATION</span><div class="contact-layout"><div><h2 id="contact-title">Let’s untangle<br /><span>the hard part.</span></h2><p>Tell me what you’re building, where things get difficult, and how another engineering perspective could help.</p></div><div class="contact-action"><span class="mono">A GOOD NEXT STEP</span><a class="button button-light" href={contactUrl}>{profile.contact.email ? 'Send me an email' : 'Connect on GitHub'} <Arrow external /></a><p>{profile.contact.email ? 'Share a little context so we have a useful starting point.' : 'GitHub is my temporary contact route. A direct email option will be added when it’s configured.'}</p></div></div><div class="contact-bottom mono"><span>BACKEND ENGINEERING / BERLIN</span><span>LET’S BUILD SOMETHING USEFUL.</span></div></div></section>
</Layout>
