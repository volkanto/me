---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { profile, projects, services, principles } from '../content';
import { withBase } from '../urls';
const rook = projects[0];
const contactUrl = profile.contact.email ? `mailto:${profile.contact.email}` : profile.contact.github;
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-context mono"><span class="status-dot" aria-hidden="true"></span> SOFTWARE ENGINEER <span class="context-slash">/</span> BERLIN, DE</div>
    <h1 id="hero-title">Reliable systems.<br /><span>Useful little tools.</span></h1>
    <div class="hero-bottom"><div><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button" href="#work">Explore my work <Arrow /></a><a class="text-link" href="#contact">Discuss a project <Arrow /></a></div></div><p class="hero-aside"><span class="mono">MY KIND OF SOFTWARE</span>Thoughtful on the inside.<br />Useful on the outside.</p></div>
    <div class="hero-foot mono"><span>BACKEND ENGINEERING · OPEN SOURCE</span><a href="#work">SELECTED WORK <span aria-hidden="true">↓</span></a></div>
  </section>
  <section id="work" class="work-section wrap" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">01 / SELECTED WORK</span><h2 id="work-title">Small tools.<br />Real everyday problems.</h2></div><p>I build things I want to use.<br />Then I share them with everyone.</p></div>
    <article class="featured-project">
      <div class="featured-copy"><div class="project-meta mono"><span>01</span><span>{rook.kind}</span></div><h3>{rook.name}</h3><p class="project-headline">{rook.headline}</p><p>{rook.description}</p><ul class="feature-list"><li>Private, local-first storage</li><li>Weekly & monthly summaries</li><li>Markdown export & backups</li></ul><div class="tags">{rook.stack.map(tag => <span>{tag}</span>)}</div><div class="project-links"><a class="text-link" href={withBase(`projects/${rook.slug}/`)}>Explore the project <Arrow /></a><a href={rook.source}>Source <Arrow external /></a>{rook.live && <a href={rook.live}>Open app <Arrow external /></a>}</div></div>
      <ProjectVisual slug={rook.slug} />
    </article>
    <div class="secondary-projects">{projects.slice(1).map(project => <article class="compact-project"><div class="project-meta mono"><span>{project.number}</span><span>{project.kind}</span></div><h3>{project.name}</h3><p>{project.description}</p><p class="project-audience">{project.audience}</p><ProjectVisual slug={project.slug} /><div class="project-links"><a class="text-link" href={withBase(`projects/${project.slug}/`)}>Explore the project <Arrow /></a><a href={project.source}>Source <Arrow external /></a></div></article>)}</div>
    <a class="all-work text-link" href={profile.github}>More experiments on GitHub <Arrow external /></a>
  </section>
  <section class="approach-section" aria-labelledby="approach-title"><div class="wrap approach-layout"><div><span class="eyebrow">02 / ENGINEERING APPROACH</span><h2 id="approach-title">Good systems start<br />with good questions.</h2><p>I care about the parts that make software dependable long after the first release.</p></div><div class="principles">{principles.map((item, i) => <div class="principle"><span class="mono">0{i + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></div>)}</div></div></section>
  <section id="consulting" class="consulting-section wrap" aria-labelledby="consulting-title"><div class="section-heading"><div><span class="eyebrow">03 / CONSULTING</span><h2 id="consulting-title">Have a backend<br />challenge?</h2></div><p>I help teams design, review, and improve Java and Spring Boot systems—from architecture decisions to production reliability.</p></div><div class="services">{services.map((service, i) => <article><span class="mono">0{i + 1}</span><h3>{service.title}</h3><p>{service.problem}</p><p class="service-result">{service.result}</p></article>)}</div><div class="process"><span class="eyebrow">HOW WE COULD WORK TOGETHER</span><ol><li><span>01</span>Share the challenge<br />and relevant context.</li><li><span>02</span>Agree on scope,<br />deliverables, and timing.</li><li><span>03</span>Work through the problem.<br />Leave with actionable next steps.</li></ol><a class="text-link" href="#contact">Let’s discuss your project <Arrow /></a></div></section>
  <section id="about" class="about-section wrap" aria-labelledby="about-title"><div class="about-label"><span class="eyebrow">04 / A LITTLE ABOUT ME</span><div class="location-stamp"><span class="mono">BASED IN</span><span>Berlin.</span><span class="mono">52°31′ N &nbsp; 13°24′ E</span></div></div><div class="about-copy"><h2 id="about-title">Behind the systems,<br />a curious person.</h2><p>{profile.about}</p><p>I care about reliability, simplicity, and software that earns its place in someone’s day.</p><a class="text-link" href={profile.github}>Find me on GitHub <Arrow external /></a></div></section>
  <aside class="support-section wrap"><div><span class="eyebrow">OPEN SOURCE, OPEN TO EVERYONE</span><h2>Found something useful?</h2><p>If my projects make your day a little easier, you can support their continued development.</p></div><a class="text-link" href={profile.sponsors}>Support on GitHub Sponsors <Arrow external /></a></aside>
  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="wrap contact-layout"><div><span class="eyebrow">05 / LET’S TALK</span><h2 id="contact-title">What are<br />you building?</h2><p>Tell me about your project, the challenge you’re facing, and where another engineering perspective could help.</p></div><div class="contact-action"><span class="mono">START A CONVERSATION</span><a class="button button-light" href={contactUrl}>{profile.contact.email ? 'Send me an email' : 'Find me on GitHub'} <Arrow external /></a><p>{profile.contact.email ? 'Share a little context so we have a useful starting point.' : 'GitHub is my temporary contact route. A direct email option will be added here when it’s configured.'}</p></div></div></section>
</Layout>
